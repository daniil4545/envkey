#!/usr/bin/env python3
"""Завести или обновить секрет. Значение вводится вручную и не попадает в аргументы.

keyset <контекст[/проект]/сервис> ИМЯ                 - Keychain (security спрашивает сам)
keyset -f DIR ИМЯ                                     - секрет в файл; скрытый ввод или stdin
keyset -f DIR --public ИМЯ [значение]                 - публичная переменная
keyset -f DIR --from-keychain <контекст>/<проект>/<сервис> - перенос записей Keychain в файл
"""

import getpass
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import envfile  # noqa: E402
import keychain  # noqa: E402

USAGE = (
    "использование: keyset <контекст[/проект]/сервис> ИМЯ\n"
    "               keyset -f DIR [--public] ИМЯ [значение с --public]\n"
    "               keyset -f DIR --from-keychain ПУТЬ"
)


def keychain_mode(rest):
    if len(rest) != 2:
        raise envfile.EnvError(USAGE + "\nпример: keyset myctx/myapp/openrouter OPENROUTER_API_KEY")
    path, name = rest
    if path.count("/") >= 3:
        raise envfile.EnvError(f"путь глубже двух уровней: {path}")
    if "/" not in path:
        raise envfile.EnvError(f"нужен хотя бы контекст/сервис, получено: {path}")
    print(f"Введите значение для {name} ({path}), ввод не отображается:", file=sys.stderr)
    code = keychain.add_secret(path, name)
    if code != 0:
        sys.exit(code)
    print(f"keyset: {path} -> {name} сохранён", file=sys.stderr)


def read_value(name):
    if sys.stdin.isatty():
        raw = getpass.getpass(f"Введите значение для {name}, ввод не отображается: ")
    else:
        raw = sys.stdin.buffer.read().decode("utf-8", "surrogateescape")
        if raw.endswith("\r\n"):
            raw = raw[:-2]
        elif raw.endswith("\n"):
            raw = raw[:-1]
    return raw


def from_keychain(doc, path):
    names = sorted({account for service, account in keychain.list_items() if service == path})
    if not names:
        raise envfile.EnvError(f"в Keychain нет записей {path}")
    pending = []
    for name in names:
        if not envfile.NAME_RE.match(name):
            raise envfile.EnvError(f"имя записи {name} не подходит для файла")
        try:
            value = keychain.read_secret(path, name)
            envfile.check_value(value)
        except (keychain.KeychainError, envfile.EnvError) as exc:
            raise envfile.EnvError(f"{name}: {exc}") from None
        pending.append((name, value))
    for name, value in pending:
        doc.set(name, value, public=False)
    return names


def file_mode(opts, rest):
    directory = opts["-f"]
    if "--from-keychain" in opts:
        if rest or "--public" in opts:
            raise envfile.EnvError(USAGE)
        doc = envfile.open_for_edit(directory, create=True)
        names = from_keychain(doc, opts["--from-keychain"])
        doc.save()
        print("\n".join(names))
        return
    public = "--public" in opts
    if not rest or len(rest) > 2 or (len(rest) == 2 and not public):
        raise envfile.EnvError(USAGE + "\nзначение аргументом допустимо только с --public")
    name = rest[0]
    if not envfile.NAME_RE.match(name):
        raise envfile.EnvError("имя не вида [A-Za-z_][A-Za-z0-9_]*")
    doc = envfile.open_for_edit(directory, create=True)
    value = rest[1] if len(rest) == 2 else read_value(name)
    doc.set(name, value, public)
    doc.save()
    print(f"keyset: {name} сохранён", file=sys.stderr)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts, rest = envfile.split_opts(
            argv, valued=("-f", "--from-keychain"), boolean=("--public",)
        )
        if "-f" in opts:
            file_mode(opts, rest)
        elif opts:
            raise envfile.EnvError("флаги --public и --from-keychain требуют -f DIR")
        else:
            keychain_mode(rest)
    except envfile.EnvError as exc:
        envfile.fail("keyset", str(exc), exc.code)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Переименовать переменную в файле ключей; метка `# public` остаётся над строкой.

keymv -f DIR СТАРОЕ НОВОЕ
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import envfile  # noqa: E402

USAGE = "использование: keymv -f DIR СТАРОЕ НОВОЕ"


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts, rest = envfile.split_opts(argv, valued=("-f",))
        if "-f" not in opts or len(rest) != 2:
            raise envfile.EnvError(USAGE)
        doc = envfile.open_for_edit(opts["-f"], create=False)
        doc.rename(rest[0], rest[1])
        doc.save()
    except envfile.EnvError as exc:
        envfile.fail("keymv", str(exc), exc.code)
    print(f"keymv: {rest[0]} -> {rest[1]}", file=sys.stderr)


if __name__ == "__main__":
    main()

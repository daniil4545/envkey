#!/usr/bin/env python3
"""Показать заведённые секреты. Значения секретов не выводятся.

keyls [префикс]  - Keychain: путь и имя переменной.
keyls -f DIR     - файл ключей: ИМЯ<TAB>значение для публичных, ИМЯ<TAB><секрет> для прочих.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import envfile  # noqa: E402
import keychain  # noqa: E402


def keychain_mode(prefix):
    rows = set()
    for service, account in keychain.list_items():
        if "/" not in service:
            continue
        if prefix == "" or service == prefix or service.startswith(prefix + "/"):
            rows.add((service, account))
    for service, account in sorted(rows):
        print("%-40s %s" % (service, account))


def file_mode(directory):
    path, searched = envfile.find_file(directory)
    if not path:
        raise envfile.EnvError("файла нет, искали: " + ", ".join(searched))
    doc = envfile.Document.load(path)
    print(f"keyls: {path}", file=sys.stderr)
    for name, (value, public) in doc.effective().items():
        print(f"{name}\t{value if public else '<секрет>'}")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        opts, rest = envfile.split_opts(argv, valued=("-f",))
        if "-f" in opts:
            if rest:
                raise envfile.EnvError("использование: keyls -f DIR")
            file_mode(opts["-f"])
        else:
            if len(rest) > 1:
                raise envfile.EnvError("использование: keyls [префикс] | keyls -f DIR")
            keychain_mode(rest[0] if rest else "")
    except envfile.EnvError as exc:
        envfile.fail("keyls", str(exc), exc.code)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Запуск команды с секретами из Keychain в окружении дочернего процесса.

Значения никогда не печатаются самой обёрткой и не передаются другим процессам
аргументами командной строки. Если вывод уходит в пайп (запуск из-под агента или
в лог), вхождения значений в stdout и stderr заменяются на маркер.

С флагом --prod поверх ключей Keychain подкладываются защищённые значения: их
читает помощник из WITHKEY_PROD_READER под sudo, и владелец подтверждает чтение
(пароль или отпечаток). Флаг обязателен явно: молчаливая подстановка боевого
ключа в локальный запуск - та авария, от которой режим защищает. Подробно - README.
"""

import os
import re
import subprocess
import sys
import threading

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import envfile  # noqa: E402
import keychain  # noqa: E402

ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
MIN_MASK_LEN = 6
PROD_READER_ENV = "WITHKEY_PROD_READER"

USAGE = (
    "использование: withkey [--prod] <префикс> [префикс...] -- команда [аргументы]\n"
    "               withkey -f DIR [префикс...] -- команда [аргументы]"
)


def die(message):
    print(f"withkey: {message}", file=sys.stderr)
    sys.exit(2)


def parse_args(argv):
    prod = False
    if "--" not in argv:
        die(f"нет разделителя --\n{USAGE}")
    split = argv.index("--")
    head, command = argv[:split], argv[split + 1:]
    directory = None
    if "-f" in head:
        at = head.index("-f")
        if at + 1 >= len(head):
            die("у флага -f нет каталога")
        directory = head[at + 1]
        head = head[:at] + head[at + 2:]
    if head and head[0] == "--prod":
        prod = True
        head = head[1:]
    if prod and directory is not None:
        die("--prod с -f не сочетается")
    prefixes = head
    if not prefixes and directory is None:
        die("не указан ни один префикс")
    if not command:
        die("после -- не указана команда")
    return prod, prefixes, command, directory


def expand(prefix):
    """контекст -> [контекст]; контекст/проект -> [контекст, контекст/проект]."""
    parts = [p for p in prefix.strip("/").split("/") if p]
    if len(parts) == 1:
        return parts
    if len(parts) == 2:
        return [parts[0], "/".join(parts)]
    die(f"префикс глубже двух уровней: {prefix}")


def collect(prefixes):
    """Записи ровно на один сегмент ниже префикса, в порядке применения.

    Пустой уровень не ошибка (у контекста может не быть общих ключей), но о нём
    предупреждаем: чаще всего это опечатка в имени проекта.
    """
    items = keychain.list_items()
    selected = []
    for prefix in prefixes:
        level = [
            (service, account)
            for service, account in items
            if service.startswith(prefix + "/") and "/" not in service[len(prefix) + 1:]
        ]
        if not level:
            print(f"withkey: по префиксу {prefix} записей нет", file=sys.stderr)
        selected.extend(level)
    return selected


def read_prod(paths):
    """Защищённые значения через sudo <помощник> <контекст/проект>, по вызову на проект.

    Окно доверия sudo закрывается сразу после чтения: без этого следующая команда
    агента прошла бы под правами владельца без отдельного касания.
    """
    reader = os.environ.get(PROD_READER_ENV)
    if not reader:
        die(f"--prod требует {PROD_READER_ENV}: путь к помощнику чтения, см. README")
    values = {}
    try:
        for path in paths:
            result = subprocess.run(
                ["sudo", reader, path], capture_output=True, text=True
            )
            if result.returncode != 0:
                message = result.stderr.strip() or f"код {result.returncode}"
                die(f"защищённые значения недоступны для {path}: {message}")
            values.update(parse_env(result.stdout, path))
    finally:
        subprocess.run(["sudo", "-k"], check=False)
    return values


def parse_env(text, source):
    """Строки ENV_NAME=значение. В сообщениях об ошибке только номер строки."""
    values = {}
    for number, line in enumerate(text.splitlines(), start=1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        name, sep, value = line.partition("=")
        name = name.strip()
        if not sep or not ENV_NAME.match(name):
            die(f"{source}: строка {number} не вида ENV_NAME=значение")
        values[name] = value
    if not values:
        die(f"{source}: ни одной переменной")
    return values


def load_file_layer(directory):
    """Окружение и маски из файла ключей. Секреты - все строки без метки `# public`."""
    try:
        path, searched = envfile.find_file(directory)
        if not path:
            die("файла нет, искали: " + ", ".join(searched))
        doc = envfile.Document.load(path)
    except envfile.EnvError as exc:
        die(f"{exc}")
    values = {name: value for name, (value, _) in doc.effective().items()}
    return values, doc.secret_values()


def read_keychain(found):
    secrets = {}
    for service, account in found:
        try:
            secrets[account] = keychain.read_secret(service, account)
        except keychain.KeychainError as exc:
            die(str(exc))
    return secrets


def main(argv=None):
    prod, prefixes, command, directory = parse_args(sys.argv[1:] if argv is None else argv)
    ordered = []
    for prefix in prefixes:
        ordered.extend(expand(prefix))

    file_values, mask_pairs = {}, []
    if directory is not None:
        file_values, mask_pairs = load_file_layer(directory)

    found = collect(ordered) if ordered else []
    secrets = read_keychain(found)
    mask_pairs = mask_pairs + [(value, name) for name, value in secrets.items()]

    if prod:
        # Защищённый путь - префикс из двух сегментов: помощник хранит секреты
        # по проектам, контекст целиком одним файлом не покрывается.
        paths = [p.strip("/") for p in prefixes if len(p.strip("/").split("/")) == 2]
        if not paths:
            die("--prod требует префикс вида <контекст>/<проект>")
        prod_values = read_prod(paths)
        secrets.update(prod_values)
        mask_pairs += [(value, name) for name, value in prod_values.items()]
    elif not found and directory is None:
        die(f"по префиксам {' '.join(ordered)} не найдено ни одной записи")

    env = os.environ.copy()
    env.update(file_values)
    env.update(secrets)

    if sys.stdout.isatty():
        try:
            os.execvpe(command[0], command, env)
        except OSError as exc:
            exec_failed(command[0], exc)

    masks = sorted(
        {(value, name) for value, name in mask_pairs if len(value) >= MIN_MASK_LEN},
        key=lambda pair: len(pair[0]), reverse=True,
    )
    try:
        process = subprocess.Popen(
            command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
    except OSError as exc:
        exec_failed(command[0], exc)
    threads = [
        threading.Thread(target=pump, args=(process.stdout, sys.stdout, masks)),
        threading.Thread(target=pump, args=(process.stderr, sys.stderr, masks)),
    ]
    for thread in threads:
        thread.start()
    code = process.wait()
    for thread in threads:
        thread.join()
    sys.exit(code)


def exec_failed(name, exc):
    """Команда не запустилась: 127 - не найдена, 126 - нет прав."""
    print(f"withkey: не удалось запустить {name}: {exc.strerror}", file=sys.stderr)
    sys.exit(127 if isinstance(exc, FileNotFoundError) else 126)


def pump(source, sink, masks):
    """Построчно переливает поток, скрывая значения секретов."""
    for line in iter(source.readline, b""):
        text = line.decode("utf-8", "replace")
        for value, name in masks:
            text = text.replace(value, f"[скрыто {name}]")
        sink.write(text)
        sink.flush()
    source.close()


if __name__ == "__main__":
    main()
